[TEMPLATE]
# Oilora Blue AI — Environment Configuration
# Copy to backend/.env and modify as needed. Never commit the real .env file.
# This file contains setting NAMES only — no secrets.

# Application
APP_NAME="Oilora Blue AI"
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database — single authoritative path (SQLite via the built-in sqlite3 module).
# May be relative or absolute; resolved to an absolute path at startup.
# Default when unset: backend/oilora_blue.db
DATABASE_PATH=oilora_blue.db

# Storage
DATA_DIR=./data
MODELS_DIR=./models

# File limits
MAX_UPLOAD_SIZE_MB=2048

# Security
ENABLE_LOCAL_DEMO_MODE=true
LOG_LEVEL=INFO

# ─── Provider credentials (backend-only, never commit real values) ─────
# Set real values in backend/.env — the application reports "Authentication
# required" when these are empty and never returns them through the API.
#
# Copernicus Data Space Ecosystem (Sentinel-1 product downloads)
# https://documentation.dataspace.copernicus.eu/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
#
# Copernicus Marine Service (ocean currents, GLOBAL_ANALYSISFORECAST_PHY_001_024)
# https://data.marine.copernicus.eu/
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
#
# Global Fishing Watch (authorized AIS access only)
# https://globalfishingwatch.org/
GFW_API_TOKEN=