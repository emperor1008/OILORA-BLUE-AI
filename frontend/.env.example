# Oilora Blue AI — frontend environment (names only, never secrets)
# Copy to frontend/.env.local and adjust if needed. All variables are optional;
# safe built-in defaults are used when unset.

# Override the Satellite Context raster tile URL (default: NASA GIBS
# BlueMarble_NextGeneration WMTS, keyless). Must be a {z}/{x}/{y} XYZ/XYZ-{y}
# template served by a legally usable provider.
NEXT_PUBLIC_SATELLITE_TILES=

# Attribution text shown for the satellite raster source.
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=

# Override the Ocean / Street basemap raster tile URL (default: CARTO Voyager).
NEXT_PUBLIC_BASEMAP_STYLE_URL=